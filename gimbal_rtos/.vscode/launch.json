        {
            "name": "STM32 Debug (DAP)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/RM26_H7.elf",
            "configFiles": [
                // "${workspaceFolder}/daplink.cfg"
                "interface/cmsis-dap.cfg",  // 告诉 OpenOCD 用 DAP-Link
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IGH6",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            // "svdFile": "${workspaceFolder}/STM32H7.svd"
        },

    ]
